# ===========================================
# Secura Environment Configuration
# ===========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ===========================================

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=secura
POSTGRES_USER=secura_user
POSTGRES_PASSWORD=secura_secure_password
DATABASE_URL=postgres://secura_user:secura_secure_password@db:5432/secura

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=your-jwt-signing-key-change-this

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,jpg,jpeg,png,gif,tiff,mp4,mp3,wav,zip

# Digital Signature
SIGNING_SECRET_KEY=your-signing-secret-key-change-this

# Blockchain (Simulation)
BLOCKCHAIN_ENABLED=True

# AI Features
AI_ENABLED=True
AI_PROVIDER=mock
# AI_API_KEY=your-api-key-if-using-external-llm
# AI_MODEL=gpt-4

# Security
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Redis (Optional - for caching)
# REDIS_URL=redis://redis:6379/0
